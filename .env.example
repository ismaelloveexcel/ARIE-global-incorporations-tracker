# —— Operator / engineering mode ——
# development | staging | production
# production = RM workstation: prepared snapshots only, no /dev UI, no in-app registry fetch
APP_MODE=development

# —— UK Companies House (required for pipeline + dev snapshot builds) ——
# Register at https://developer.company-information.service.gov.uk/
# Replace the placeholder below with your real API key (do not commit .env).
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# —— OpenAI (optional — AI brief in lead detail panel only) ——
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# —— Supabase (optional — batch pipeline / main.py only, not the operator dashboard) ——
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# —— Pipeline ——
# Days back to fetch new UK incorporations (default: 1)
LOOKBACK_DAYS=1

# —— Dashboard ——
# How many past snapshot dates appear in the header date picker (default: 30)
SNAPSHOT_NAV_DAYS=30

# When opening a snapshot date, auto-merge Mauritius GBC/AC if missing (default: true)
# Uses engineering fetch in dev; production expects overnight pipeline output in exports/
MAURITIUS_AUTO_REFRESH=true
